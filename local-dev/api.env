# ServX Local Development Environment Configuration
# API Service (Port 5000)

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27019/servx_local
MONGODB_SHOP_URI=mongodb://127.0.0.1:27019/servx_demo_shop
REDIS_URL=redis://127.0.0.1:6381/0
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Fixed 32-byte (64 hex characters) AES encryption key for local-only development
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# ─── Production Override Masking ───────────────────────────────────────────────
# Explicitly set all external/cloud provider keys to empty strings so no
# production configuration from apps/api/.env leaks in.
ADMIN_EMAIL=
SERVICE_AUTH_TOKEN=
SERVE_FRONTEND=
CHROME_PATH=

# GitHub OAuth & Webhooks
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
